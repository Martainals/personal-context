{
  "profile_version": 3,
  "provider": "qwen-mlx",
  "display_name": "Qwen3-ASR BF16 for Apple Silicon",
  "platform": {
    "system": "Darwin",
    "machine": ["arm64", "aarch64"]
  },
  "runtime": {
    "python": "3.12",
    "uv": "0.12.3",
    "packages": [
      "mlx-audio[stt]==0.4.6"
    ]
  },
  "models": {
    "asr": {
      "repo_id": "mlx-community/Qwen3-ASR-1.7B-bf16",
      "revision": "e1f6c266914abc5a46e8756e02580f834a6cf8a7",
      "license": "Apache-2.0"
    },
    "aligner": {
      "repo_id": "mlx-community/Qwen3-ForcedAligner-0.6B-bf16",
      "revision": "53c8c0e46733eec430e4b53dd6471d0e5dee45f8",
      "license": "Apache-2.0"
    },
    "diarizer": {
      "repo_id": "mlx-community/diar_streaming_sortformer_4spk-v2.1-fp32",
      "revision": "8541fc3db304f350b544bbcab1cfae4f3eeb2356",
      "license": "NVIDIA Open Model License"
    }
  },
  "artifacts": {
    "contract_version": 1,
    "format": "json+gzip",
    "normalization_version": "mono-16k-v1",
    "stage_versions": {
      "asr": 1,
      "alignment": 1,
      "diarization": 1,
      "speaker-turns": 1,
      "assembly": 1
    }
  },
  "diarization": {
    "mode": "high_accuracy_streaming",
    "frame_seconds": 0.08,
    "inference": {
      "activity_threshold": 0.5,
      "min_duration": 0.0,
      "merge_gap": 0.0
    },
    "streaming": {
      "chunk_frames": 340,
      "right_context_frames": 40,
      "fifo_frames": 40,
      "speaker_cache_update_frames": 300,
      "speaker_cache_frames": 188
    },
    "postprocessing": {
      "activity_threshold": 0.5,
      "reassignment_threshold": 0.2,
      "min_speech_seconds": 0.1,
      "max_silence_gap_seconds": 0.15,
      "max_weak_switch_seconds": 0.24,
      "max_weak_switch_margin": 0.18
    },
    "word_assembly": {
      "max_fragment_characters": 2,
      "max_fragment_seconds": 1.0,
      "max_fragment_gap_seconds": 0.2,
      "max_fragment_margin": 0.2,
      "max_same_speaker_gap_seconds": 1.2,
      "max_segment_characters": 280
    }
  },
  "limits": {
    "maximum_speakers": 4,
    "asr_chunk_seconds": 240,
    "download_estimate_gb": 6.5,
    "minimum_free_disk_gb": 10
  }
}
